<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CrimsonAtomtic.Ui</RootNamespace>
    <AssemblyName>CrimsonAtomtic</AssemblyName>

    <!-- Avalonia + AOT settings. PublishAot is the executable-side toggle;
         all library projects already have IsAotCompatible via
         Directory.Build.props. -->
    <PublishAot>true</PublishAot>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MainIcon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Trim XAML resources we don't reference. -->
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- ============================================================ -->
    <!-- Version: major.minor.patch is the app's own semantic version. -->
    <!--                                                               -->
    <!-- Sync convention (from 1.10.01 on): the FIRST TWO components    -->
    <!-- track the live game data version the editor parses against —   -->
    <!--   VerMajor = game major == NativePaverReader.ParserTargetMajor -->
    <!--   VerMinor = game minor == NativePaverReader.ParserTargetMinor -->
    <!-- so a game patch to 1.18 means VerMinor 17 → 18 AT THE SAME     -->
    <!-- TIME ParserTargetMinor tracks it (keep them in lock-step).     -->
    <!-- A major bump RESETS the minor (1.18 → 2.00 is 18 → 0), so the  -->
    <!-- two components always move together.                          -->
    <!-- NOTE: ParserTargetMajor/Minor are READ from the crimson-rs C ABI -->
    <!-- (Rust is the single source of truth); VerMajor/VerMinor stay    -->
    <!-- MANUAL build-identity bumps, NOT auto-derived from that ABI.    -->
    <!-- VerPatch is the editor's OWN release counter within that game  -->
    <!-- version: reset to 1 whenever VerMajor/VerMinor change, then    -->
    <!-- increment per editor release (2.00.01 → 2.00.02 → …). Build    -->
    <!-- number (4th digit) is read from the shared build_number.txt at -->
    <!-- the repo root; build.ps1 increments it once per build          -->
    <!-- invocation (MSBuild only READS it). Same single-source-of-truth -->
    <!-- pattern UE5CEDumper uses.                                      -->
    <!-- ============================================================ -->
    <VerMajor>2</VerMajor>
    <VerMinor>6</VerMinor>
    <VerPatch>2</VerPatch>
    <BuildNumberFile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\build_number.txt'))</BuildNumberFile>
    <!-- build.ps1 passes -p:VerBuild for the build it is about to count;
         otherwise the committed number is used as it is. -->
    <VerBuild Condition="'$(VerBuild)' == '' and Exists('$(BuildNumberFile)')">$([System.IO.File]::ReadAllText('$(BuildNumberFile)').Trim())</VerBuild>
    <VerBuild Condition="'$(VerBuild)' == ''">0</VerBuild>

    <Version>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</Version>
    <AssemblyVersion>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</AssemblyVersion>
    <FileVersion>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</FileVersion>
    <!-- The exe's product version also names the crimson-rs commit, so a
         shipped build can be traced to the native core it links. -->
    <InformationalVersion>$(VerMajor).$(VerMinor).$(VerPatch).$(VerBuild)</InformationalVersion>
    <InformationalVersion Condition="'$(CrimsonRsRef)' != ''">$(InformationalVersion)+crimson-rs.$(CrimsonRsRef.Substring(0, 7))</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <UsesCrimsonRsDll>true</UsesCrimsonRsDll>

    <!-- Avalonia.Controls.DataGrid (12.1.2) carries internal reflection
         that ILC reports as the rolled-up IL2104 / IL3053 warnings, and
         TreatWarningsAsErrors would fail the AOT publish on them. Both
         codes name DataGrid alone: drop them from NoWarn and publish to
         see whether a new DataGrid still needs this. -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <!-- Expose internal helpers (e.g. MainWindowViewModel.TryComputeTargetStack)
       to the xUnit project for pure-logic unit tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CrimsonAtomtic.Tests" />
  </ItemGroup>

  <!-- Bundle the window icon and the logo background as Avalonia
       resources so MainWindow.axaml can resolve them at runtime via
       avares:// URIs (compatible with AOT — no runtime reflection,
       resources are baked into the assembly at compile time). -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\MainIcon.ico" />
    <AvaloniaResource Include="Assets\Logo.jpg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Angle.Windows.Natives" />
    <PackageReference Include="Avalonia.BuildServices">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.FreeDesktop" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="HarfBuzzSharp" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" />
    <PackageReference Include="MicroCom.Runtime" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrimsonAtomtic.Core\CrimsonAtomtic.Core.csproj" />
    <ProjectReference Include="..\CrimsonAtomtic.SaveModel\CrimsonAtomtic.SaveModel.csproj" />
    <ProjectReference Include="..\CrimsonAtomtic.RustInterop\CrimsonAtomtic.RustInterop.csproj" />
  </ItemGroup>

  <!-- crimson_rs.dll is produced by .\scripts\build_rust.ps1 (alongside
       crimson_rs.lib — see the staticlib ItemGroup below).
       Dev / `dotnet run` / `dotnet test` use the dll via LoadLibrary
       since those paths don't run AOT. CopyToPublishDirectory is set to
       Never because the AOT publish statically links the .lib instead —
       dist/ ships as a single self-contained .exe. The Condition lets
       the project build before the dll has ever been produced; runtime
       calls would fail then, but that surfaces in tests, not the build. -->
  <ItemGroup>
    <Content Include="$(CrimsonRsTargetDir)crimson_rs.dll" Condition="Exists('$(CrimsonRsTargetDir)crimson_rs.dll')">
      <Link>crimson_rs.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- NativeAOT publish: statically link the Rust core into the
       single-file exe via crimson_rs.lib (no crimson_rs.dll on disk at
       runtime). DirectPInvoke's Include must match the logical name in
       every [LibraryImport("crimson_rs")]. NativeLibrary hands the .lib
       to the ILC linker. Both items are no-ops outside the AOT publish
       step, so we leave them unconditional (apart from the Exists guard
       so a missing .lib doesn't break Debug builds). See
       vendor/crimson-rs/docs/c-sharp-nativeaot-integration.md.

       Userenv.lib: the Rust std pulls GetUserProfileDirectoryW (in
       userenv.dll) transitively for env::home_dir. NativeAOT's default
       linker input list doesn't include userenv.lib, so the staticlib
       fails to resolve __imp_GetUserProfileDirectoryW without this.

       Synchronization.lib: Rust 1.100's std parks threads with
       WaitOnAddress / WakeByAddressSingle / WakeByAddressAll (in
       api-ms-win-core-synch-l1-2-0), which NativeAOT's default inputs
       don't cover either. Without it the v2.05.01 CI build, the first on
       Rust 1.100, failed with LNK2019 on __imp_WaitOnAddress; the local
       1.99 toolchain did not need it. When a new Rust release breaks the
       link, rustc's "print native-static-libs" option lists what the
       staticlib wants. -->
  <ItemGroup>
    <DirectPInvoke Include="crimson_rs" />
  </ItemGroup>
  <!-- Windows import libraries and the Windows-named staticlib: another
       RID would need its own (libcrimson_rs.a and that OS's libraries). -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <NativeLibrary Include="$(CrimsonRsTargetDir)crimson_rs.lib" Condition="Exists('$(CrimsonRsTargetDir)crimson_rs.lib')" />
    <NativeLibrary Include="Userenv.lib" />
    <NativeLibrary Include="Synchronization.lib" />
  </ItemGroup>

  <!-- Windows stores each version part in 16 bits; a larger build number
       would be cut silently in the file version. -->
  <Target Name="CheckVerBuildRange" BeforeTargets="BeforeBuild">
    <Error Condition="$(VerBuild) &gt; 65535" Text="VerBuild $(VerBuild) is over 65535, the largest version part Windows accepts. Fix build_number.txt (or the -p:VerBuild passed in)." />
  </Target>

  <!-- Strip .pdb files from the publish bundle. We still produce PDBs in
       bin/Release/ for crash-dump symbolication during development, but
       the AOT-published artifact under dist/ is what we ship to users —
       and there the managed PDBs are dead weight (managed assemblies
       aren't shipped after AOT) while the native PDBs that ride along
       with SkiaSharp / HarfBuzzSharp NuGets add ~200 MB on top of a
       ~50 MB usable bundle. Build output is untouched; publish output
       is what gets pruned. -->
  <Target Name="StripPdbsAfterPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PublishPdbs Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishPdbs)" />
  </Target>

</Project>
