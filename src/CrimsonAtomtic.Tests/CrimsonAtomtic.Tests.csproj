<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CrimsonAtomtic.Tests</RootNamespace>
    <AssemblyName>CrimsonAtomtic.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Test projects don't need to be AOT-compatible. -->
    <IsAotCompatible>false</IsAotCompatible>
    <!-- xUnit naming convention (Method_Scenario_Expected) uses
         underscores; xUnit1051 wants test-context cancellation tokens
         in every call; CA1861 flags inline constant arrays passed as
         one-shot test data. All three are noise for our minimal tests. -->
    <NoWarn>$(NoWarn);CA1707;xUnit1051;CA1861</NoWarn>
    <UsesCrimsonRsDll>true</UsesCrimsonRsDll>
  </PropertyGroup>

  <!-- Only what the tests use directly. Everything else comes through the
       project references; its versions are pinned in
       Directory.Packages.props (CentralPackageTransitivePinningEnabled). -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- dotnet run drives the tests through Microsoft.Testing.Platform;
         these two are for the Visual Studio Test Explorer. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrimsonAtomtic.Core\CrimsonAtomtic.Core.csproj" />
    <ProjectReference Include="..\CrimsonAtomtic.SaveModel\CrimsonAtomtic.SaveModel.csproj" />
    <ProjectReference Include="..\CrimsonAtomtic.RustInterop\CrimsonAtomtic.RustInterop.csproj" />
    <!-- IconImageEncoder lives in the Ui project; it pulls SkiaSharp
         transitively via Avalonia.Skia. The test runner only touches
         IconImageEncoder (pure logic) so no Avalonia application
         bootstrap is required at test time. -->
    <ProjectReference Include="..\CrimsonAtomtic.Ui\CrimsonAtomtic.Ui.csproj" />
  </ItemGroup>

  <!-- Smoke tests in NativeSaveLoaderTests P/Invoke into crimson_rs.dll
       (produced by .\scripts\build_rust.ps1). Copy the dll into the
       test runner's output so [LibraryImport] can resolve it. -->
  <ItemGroup>
    <Content Include="$(CrimsonRsTargetDir)crimson_rs.dll" Condition="Exists('$(CrimsonRsTargetDir)crimson_rs.dll')">
      <Link>crimson_rs.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
